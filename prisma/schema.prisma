generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORGANISER
  STAFF
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String    @map("password_hash")
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  seatReservations SeatReservation[]
  orders           Order[]
  events           Event[]           @relation("EventOrganiser")

  @@map("users")
}

// A signed-in browser. The id is the SHA-256 of the cookie token, so a leaked
// database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  kind        String
  location    String?
  startsAt    DateTime @map("starts_at")
  createdAt   DateTime @default(now()) @map("created_at")

  organiserId String? @map("organiser_id")
  organiser   User?   @relation("EventOrganiser", fields: [organiserId], references: [id], onDelete: SetNull)

  seatLayoutId String?      @map("seat_layout_id")
  seatLayout   SeatLayout?  @relation(fields: [seatLayoutId], references: [id])
  ticketTypes  TicketType[]

  seatReservations SeatReservation[]
  orders           Order[]
  tickets          Ticket[]

  @@index([organiserId])
  @@map("events")
}

model TicketType {
  id             String    @id @default(cuid())
  eventId        String    @map("event_id")
  name           String
  price          Int
  quantity       Int
  maxPerCustomer Int?      @map("max_per_customer")
  saleStartsAt   DateTime? @map("sale_starts_at")
  saleEndsAt     DateTime? @map("sale_ends_at")
  seated         Boolean   @default(false)
  section        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model SeatLayout {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  seats  Seat[]
  events Event[]

  @@map("seat_layouts")
}

model Seat {
  id       String @id @default(cuid())
  layoutId String @map("layout_id")
  label    String
  section  String @default("main")
  rowIndex Int    @map("row_index")
  colIndex Int    @map("col_index")

  layout SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  reservations SeatReservation[]
  orderItems   OrderItem[]
  tickets      Ticket[]

  @@unique([layoutId, label])
  @@index([layoutId])
  @@map("seats")
}

enum SeatStatus {
  HELD
  SOLD
}

model SeatReservation {
  id        String     @id @default(cuid())
  eventId   String     @map("event_id")
  seatId    String     @map("seat_id")
  userId    String     @map("user_id")
  status    SeatStatus @default(HELD)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, seatId])
  @@index([eventId])
  @@index([userId])
  @@map("seat_reservations")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  TIMED_OUT
}

model Order {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  eventId   String      @map("event_id")
  status    OrderStatus @default(PENDING)
  expiresAt DateTime    @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([eventId])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  ticketTypeId String  @map("ticket_type_id")
  seatId       String? @map("seat_id")
  price        Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  seat       Seat?      @relation(fields: [seatId], references: [id])
  ticket     Ticket?

  @@unique([orderId, seatId])
  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique @map("order_id")
  providerRef String        @unique @map("provider_ref")
  phone       String
  amount      Int
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  completedAt DateTime?     @map("completed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Ticket {
  id           String    @id @default(cuid())
  orderItemId  String    @unique @map("order_item_id")
  eventId      String    @map("event_id")
  ticketTypeId String    @map("ticket_type_id")
  seatId       String?   @map("seat_id")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  seat       Seat?      @relation(fields: [seatId], references: [id])

  @@index([eventId])
  @@map("tickets")
}
