generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

// A signed-in browser. The id is the SHA-256 of the cookie token, so a leaked
// database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  kind        String
  location    String?
  startsAt    DateTime @map("starts_at")
  createdAt   DateTime @default(now()) @map("created_at")

  seatLayoutId String?     @map("seat_layout_id")
  seatLayout   SeatLayout? @relation(fields: [seatLayoutId], references: [id])
  ticketTypes TicketType[]

  @@map("events")
}

model TicketType {
  id               String    @id @default(cuid())
  eventId          String    @map("event_id")
  name             String
  price            Int
  quantity         Int
  maxPerCustomer   Int?      @map("max_per_customer")
  saleStartsAt     DateTime? @map("sale_starts_at")
  saleEndsAt       DateTime? @map("sale_ends_at")
  seated         Boolean   @default(false)
  section        String?
  createdAt        DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ticket_types")
}

model SeatLayout {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  seats  Seat[]
  events Event[]

  @@map("seat_layouts")
}

model Seat {
  id       String @id @default(cuid())
  layoutId String @map("layout_id")
  label    String
  section  String @default("main")
  rowIndex Int    @map("row_index")
  colIndex Int    @map("col_index")

  layout SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, label])
  @@index([layoutId])
  @@map("seats")
}