# Copy to .env (`make up` does this for you). Every value has a working
# default in docker-compose.yml, so .env only holds what you want to change.
#
# [compose]  read by Docker Compose when it starts containers
# [runtime]  read by the app when it starts; a restart picks up a change
# [build]    inlined into the JavaScript bundle by `next build`; a change
#            needs a rebuild (`docker compose up --build`)

# --- Database --------------------------------------------------------------

# [runtime] Postgres superuser and database, created on first start of the
# db container. Changing them later needs `make reset` (it wipes the data).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ticketing

# [compose] Host port for Postgres, bound to 127.0.0.1 only. Not 5432, so it
# does not collide with a Postgres already installed on your machine.
POSTGRES_PORT=5433

# [runtime] Connection string for commands you run on your host machine
# (npm run dev, npx prisma studio). Containers do not read this value:
# docker-compose.yml builds theirs from the POSTGRES_* values above.
DATABASE_URL=postgresql://app:app@localhost:5433/ticketing

# --- App -------------------------------------------------------------------

# [compose] Host port the app is published on.
APP_PORT=3000

# [runtime] Public URL of the app. Session cookies are marked Secure only
# when this starts with https://.
APP_URL=http://localhost:3000

# [runtime] Shared secret the mocked mobile money provider sends in the
# x-callback-secret header. Callbacks without it are refused. The default is
# for development only: set your own value anywhere else.
PAYMENT_CALLBACK_SECRET=dev-callback-secret

# [build] Display name shown in the header and page title.
NEXT_PUBLIC_APP_NAME=Ticketing System